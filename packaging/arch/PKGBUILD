# Maintainer: nnoah29
pkgname=five
pkgver=0.1.0
pkgrel=1
pkgdesc='A fast, native file manager with folder cards, previews and automation rules'
arch=('x86_64')
url='https://github.com/nnoah29/FIVE'
license=('LicenseRef-Unspecified')
depends=('gtk4>=4.16' 'pango>=1.56')
makedepends=('rust' 'git')
source=("$pkgname-$pkgver.tar.gz::https://github.com/nnoah29/FIVE/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "FIVE-$pkgver"
  cargo build --release --locked -p five-gtk
}

package() {
  cd "FIVE-$pkgver"
  FIVE_ROOT="$PWD" packaging/stage.sh "$pkgdir" /usr
}
